<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core's tests: a fake game folder and fake mods in %TEMP%. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- #if HAS_NEXUS -->
    <!-- the tests cover every part, the Nexus Mods one too; -p:NoNexus=true tests the build
         without it, as the public repository has it (tools/export_public.py) -->
    <DefineConstants Condition="'$(NoNexus)' != 'true'">$(DefineConstants);HAS_NEXUS</DefineConstants>
    <!-- #endif -->
  </PropertyGroup>

  <!-- a build with another output path must still ignore the default obj\ and bin\ -->
  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\core\*.cs" Link="core\%(Filename)%(Extension)" />
    <!-- our own builds' part and its tests, kept out of the repository (.gitignore) -->
    <Compile Include="..\private\core\*.cs" Link="private\core\%(Filename)%(Extension)" />
    <Compile Include="..\private\tests\*.cs" Link="private\tests\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the 7z samples SevenZipTests.cs unpacks -->
  <ItemGroup>
    <None Update="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the license plugin, built first and put beside the tests as beside the program -->
  <ItemGroup>
    <ProjectReference Include="..\plugins\License\HD2QD.License.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\plugins\License\bin\$(Configuration)\net48\HD2QD.License.dll" Link="HD2QD.License.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
