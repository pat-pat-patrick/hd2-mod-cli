<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.License.dll: the license plugin (HD2 Mod License, utilities\hd2-mod-license's
       protocol). The manager loads it from its own folder when it is there (core\Plugins.cs)
       and works as before without it. It shares no types with the manager: its methods take
       and give strings, numbers and the Json shapes only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2QD.License</AssemblyName>
    <RootNamespace>Hd2Mod.License</RootNamespace>
    <Version>1.0.0</Version>
    <Product>hd2-mod-cli</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)\..\..=src</PathMap>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\core\Json.cs" Link="Json.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
