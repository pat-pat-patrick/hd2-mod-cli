<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2 Mod Quick Deploy: the window over the core (..\..\core). WPF on the .NET
       Framework 4.8 every Windows 10 (1903+) and 11 has; the look of HD2 Mod
       Setting GUI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2 Mod Quick Deploy</AssemblyName>
    <RootNamespace>QuickDeploy</RootNamespace>
    <Version>0.12.0</Version>
    <Product>HD2 Mod Quick Deploy</Product>
    <Company>pat-pat-patrick</Company>
    <Copyright>MIT License</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- no paths of the build machine in the exe -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

    <!-- #if HAS_NEXUS -->
  <!-- Our own builds are the ones made where official.txt sits beside build.bat: that file is
       not in the repository, so a build anyone else makes identifies itself as unofficial and
       leaves Nexus Mods out (its API has to be registered per application). -p:WithNexus=true
       puts it back in; -p:NoNexus=true takes it out of ours. Signing in to Nexus Mods needs the
       client id Nexus Mods issues to each registered application: it is read from
       nexus_client_id.txt beside build.bat, which is not in the repository either. -->
  <PropertyGroup>
    <_Official Condition="Exists('$(MSBuildThisFileDirectory)..\..\official.txt')">true</_Official>
    <_HasNexus Condition="'$(_Official)' == 'true' or '$(WithNexus)' == 'true'">true</_HasNexus>
    <_HasNexus Condition="'$(NoNexus)' == 'true'"></_HasNexus>
    <DefineConstants Condition="'$(_HasNexus)' == 'true'">$(DefineConstants);HAS_NEXUS</DefineConstants>
    <NexusClientId Condition="'$(_HasNexus)' == 'true' and Exists('$(MSBuildThisFileDirectory)..\..\nexus_client_id.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\nexus_client_id.txt').Trim())</NexusClientId>
  </PropertyGroup>
  <ItemGroup Condition="'$(NexusClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NexusClientId</_Parameter1>
      <_Parameter2>$(NexusClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
    <!-- #endif -->

  <!-- a build with another output path (the no-nexus build) must still ignore the
       default obj\ and bin\, or their generated files are compiled twice -->
  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\core\*.cs" Link="core\%(Filename)%(Extension)" />
    <!-- our own builds' part, kept out of the repository (.gitignore): nothing when it is not there -->
    <Compile Include="..\..\private\core\*.cs" Link="private\core\%(Filename)%(Extension)" />
    <Compile Include="..\..\private\gui\*.cs" Link="private\gui\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

</Project>
