<Application x:Class="QuickDeploy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- the design board's tokens, its dark theme ("夜战 / 默认") -->
    <Color x:Key="CGround900">#0C0E11</Color>
    <Color x:Key="CGround700">#1A1D21</Color>
    <Color x:Key="CGrid">#30353C</Color>
    <Color x:Key="CInk">#F2EFE4</Color>
    <Color x:Key="CMuted">#A9A596</Color>
    <Color x:Key="CYellow">#FFD23F</Color>
    <Color x:Key="CBlue">#5AAAFF</Color>
    <Color x:Key="CTapeInk">#14120A</Color>
    <!-- only for what cannot be undone (deleting a mod from the disk) -->
    <Color x:Key="CRed">#E5484D</Color>
    <SolidColorBrush x:Key="Ground900" Color="{StaticResource CGround900}"/>
    <SolidColorBrush x:Key="Ground700" Color="{StaticResource CGround700}"/>
    <SolidColorBrush x:Key="Grid" Color="{StaticResource CGrid}"/>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource CInk}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource CMuted}"/>
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource CYellow}"/>
    <SolidColorBrush x:Key="Blue" Color="{StaticResource CBlue}"/>
    <SolidColorBrush x:Key="TapeInk" Color="{StaticResource CTapeInk}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource CRed}"/>
    <!-- every other row of a list in a card: faint, so a name and its number on the far side pair up -->
    <SolidColorBrush x:Key="Band" Color="#0FFFFFFF"/>

    <!-- Latin and figures in Bahnschrift (the design's Chakra Petch is not on
         players' machines), Chinese falling back to YaHei UI; values mono -->
    <FontFamily x:Key="Ui">Bahnschrift, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- no colour, family or size here: an implicit TextBlock style reaches
         into every control's template and held the chosen segment's and
         the primary button's text light on yellow. They inherit from the
         window (MainWindow: Ink, Ui, 14) and from their control. -->
    <Style TargetType="TextBlock">
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <!-- a button with no style of its own (a plain template drawn in code) takes the window's
         ink, not the system's black text: twice that black came out on the dark ground (the
         label rows 2026-10-24, the profile title 2026-10-25) -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <!-- a button: hard edges, a grid line round it; its text yellow under the pointer -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Grid}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Yellow}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Muted}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Background" Value="{StaticResource Yellow}"/>
      <Setter Property="Foreground" Value="{StaticResource TapeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="{StaticResource CYellow}" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
              </Border.Effect>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- an action that cannot be undone: a red frame around the usual words on the usual
         ground; filled red only under the mouse (the user, 2026-10-24) -->
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the title bar's own buttons (inside the window's chrome: they must take the mouse) -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- yellow, not red: red is only for what kills (the design system) -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter Property="Foreground" Value="{StaticResource TapeInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the switch: a hard-edged track, its knob; on: yellow and ink -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="44" Height="24" Background="{StaticResource Grid}" Padding="2">
              <Border x:Name="knob" Width="20" Height="20" Background="{StaticResource Muted}" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- no slide: a row is built again after a change, and a switch that slid
                   in each time it was built played its animation on every click -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter TargetName="knob" Property="Background" Value="{StaticResource TapeInk}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a choice's segment: chosen, yellow with ink -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" Padding="12,0" MinHeight="32" Margin="2">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter Property="Foreground" Value="{StaticResource TapeInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a button that lives inside the search field: no frame of its own -->
    <Style x:Key="InField" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="36">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a tick in a list: a square of the grid's colour, yellow with a dark mark when taken
         (the user, 2026-10-24: not Windows' own box) -->
    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Border x:Name="b" DockPanel.Dock="Left" Width="20" Height="20" Background="{StaticResource Ground900}"
                      BorderBrush="{StaticResource Grid}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <Path x:Name="mark" Data="M3,9.5 L7.5,14 L15,5.5" Stroke="{StaticResource TapeInk}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Yellow}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a multi-select's choice: a chip of its own (apart from the others: any
         of them may be taken), yellow while taken -->
    <Style x:Key="Chip" TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,3,6,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Grid}" BorderThickness="1" Padding="12,0" MinHeight="34">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Yellow}"/>
                <Setter Property="Foreground" Value="{StaticResource TapeInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the right-click menu: a plain dark list, scrolling when it is given a MaxHeight it would
         pass (the conflicts view's option menu ran off the screen) -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{StaticResource Ground700}" BorderBrush="{StaticResource Grid}" BorderThickness="1" Padding="0,4">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel IsItemsHost="True"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a menu's dividing line, from the same left edge as the words: the default one left room
         for an icon column these menus do not have -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="16,4" Background="{StaticResource Muted}" Opacity="0.6"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid MinWidth="140">
              <Border x:Name="b" Background="Transparent"/>
              <!-- a filter's choice left out: faded hazard stripes (the user, 2026-10-25) -->
              <Border x:Name="stripes" Visibility="Collapsed" Opacity="0.35">
                <Border.Background>
                  <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="10,10" SpreadMethod="Repeat">
                    <GradientStop Color="{StaticResource CYellow}" Offset="0"/>
                    <GradientStop Color="{StaticResource CYellow}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource CTapeInk}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource CTapeInk}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border Padding="16,8">
                <ContentPresenter x:Name="c" ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
              <Trigger Property="Tag" Value="exclude">
                <Setter TargetName="stripes" Property="Visibility" Value="Visible"/>
                <Setter TargetName="c" Property="Opacity" Value="0.6"/>
              </Trigger>
              <!-- a filter's choice that is taken: lit, so the menu needs no words of its own -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Yellow}"/>
                <Setter Property="Foreground" Value="{StaticResource TapeInk}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <!-- a line that cannot be chosen now looks it: greyed, no hand (the user, 2026-10-25:
                   only losing the highlight left it looking clickable) -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter TargetName="c" Property="Opacity" Value="0.55"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a line of the menu that opens one of its own (the labels to put on a mod) -->
    <Style x:Key="SubMenuItem" TargetType="MenuItem">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" Padding="16,8" MinWidth="140">
              <DockPanel>
                <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                      Margin="20,0,0,0" VerticalAlignment="Center"/>
                <ContentPresenter x:Name="c" ContentSource="Header" VerticalAlignment="Center"/>
                <Popup IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="None" HorizontalOffset="-2">
                  <Border Background="{StaticResource Ground700}" BorderBrush="{StaticResource Grid}" BorderThickness="1" Padding="0,4">
                    <StackPanel IsItemsHost="True"/>
                  </Border>
                </Popup>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Grid}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter TargetName="c" Property="Opacity" Value="0.55"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the range: a thin track, holo yellow up to the value, a square thumb -->
    <Style x:Key="ThumbSquare" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Width="14" Height="14" Background="{StaticResource Yellow}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrackPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Range" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="28">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Background="{StaticResource Yellow}" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Background="{StaticResource Grid}" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ThumbSquare}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text that can be selected and copied (Selectable.Text), drawn like a TextBlock: no frame,
         no caret, no scroll host (a Decorator), so the mouse wheel still scrolls the page -->
    <Style x:Key="Copyable" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <!-- WPF's text box draws its text 2 px in from each side (measured 2026-10-26): -2 puts it
           where a TextBlock's would be, so the edges line up with the text and buttons around it -->
      <Setter Property="Padding" Value="-2,0,-2,0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
      <Setter Property="SelectionOpacity" Value="0.45"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- an input: hard-edged, its hint inside while empty, cyan while typed in -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Ground700}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Grid}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid Margin="{TemplateBinding Padding}">
                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="Collapsed" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- an input of several lines (the problem report's description): as Input, from the top -->
    <Style x:Key="InputArea" TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <!-- the text box puts its Padding inside the content host itself, and 2 more: the
                   hint gets the same, so it starts where typed text does -->
              <Grid>
                <Border Margin="{TemplateBinding Padding}">
                  <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" VerticalAlignment="Top" TextWrapping="Wrap" Margin="2,0,2,0"
                             Visibility="Collapsed" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a thin dark scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="{StaticResource Grid}" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource Muted}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- sideways (the groups' columns): the upright bar's width and reversed track drew it 10
           px wide and moved it the wrong way (the user, 2026-10-27) -->
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="t" Background="{StaticResource Grid}" Margin="0,2"/>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{StaticResource Muted}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
